<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="配音工作台" Width="1440" Height="900" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F2F3EF" FontFamily="Microsoft YaHei UI" Foreground="#263331">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#CBD3CD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#283A35"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="BorderBrush" Value="#CBD3CD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#FFFFFF"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,11"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Left"><TextBlock Text="VOICE STUDIO  /  本地项目" FontSize="12" Foreground="#6E8179"/><TextBlock Text="配音工作台" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Name="ProjectPath" Text="请选择项目" MaxWidth="500" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#6E8179" Margin="0,0,12,0"/><Button Name="ChooseProjectButton" Content="选择项目文件夹"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Border Background="#FFFFFF" BorderBrush="#DBE1DC" BorderThickness="1" Padding="16" Margin="0,0,14,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="配音片段" FontSize="18" FontWeight="SemiBold"/><TextBlock Name="SegmentCount" Text="正在读取…" FontSize="12" Foreground="#74867E" Margin="0,5,0,16"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Name="VideoCuesButton" Content="导入画面字幕并对齐" Margin="0,0,0,8"/><Button Name="SyncCuesButton" Content="刷新画面字幕时间轴" Margin="0,0,0,8" IsEnabled="False"/><Button Name="ImportDraftButton" Content="应用节奏优化口播稿" Margin="0,0,0,8" IsEnabled="False"/><Button Name="ReloadButton" Content="从脚本重新导入" Margin="0"/></StackPanel><ListBox Name="Segments" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel></Border>
   <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#DBE1DC" BorderThickness="1" Padding="24" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Name="SegmentTitle" Text="选择一个片段" FontSize="22" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="编辑此段旁白；保存后可单独生成或重新生成。" Foreground="#75867E" Margin="0,8,0,16" FontSize="13"/><TextBox Name="Editor" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="19" Padding="18"/><TextBlock Name="SegmentInfo" Grid.Row="3" Margin="0,14,0,16" Foreground="#6C8177" Text="尚未生成音频"/><StackPanel Grid.Row="4" Orientation="Horizontal"><Button Name="SaveButton" Content="保存文字"/><Button Name="GenerateButton" Content="生成当前段" Background="#285D50" BorderBrush="#285D50" Foreground="White"/><Button Name="PlayButton" Content="试听当前段"/><Button Name="StopButton" Content="停止"/></StackPanel></Grid></Border>
   <Border Grid.Column="2" Background="#E7ECE7" BorderBrush="#D8E0D8" BorderThickness="1" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="声音设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="火山引擎 API Key" Margin="0,22,0,7" FontWeight="SemiBold"/><PasswordBox Name="ApiKey" Padding="9" Background="White" BorderBrush="#CBD3CD"/><TextBlock Text="仅保存在当前会话；关闭程序后需重新填写。" FontSize="12" Foreground="#75867E" Margin="0,7,0,0"/><TextBlock Text="预设音色（2.0）" Margin="0,22,0,7" FontWeight="SemiBold"/><ComboBox Name="VoicePreset" IsTextSearchEnabled="True" MaxDropDownHeight="360" Padding="8"/><TextBlock Text="可输入音色名称首字搜索；账号需开通所选音色。" FontSize="12" Foreground="#75867E" Margin="0,7,0,0"/><TextBlock Text="音色 ID（可手动修改）" Margin="0,14,0,7" FontWeight="SemiBold"/><TextBox Name="Speaker" Text="zh_female_vv_uranus_bigtts"/><TextBlock Text="预设选自官方 2.0 音色列表，列表会随服务更新。" FontSize="12" Foreground="#75867E" Margin="0,7,0,0"/><TextBlock Text="语速" Margin="0,22,0,7" FontWeight="SemiBold"/><DockPanel><TextBlock Name="RateValue" DockPanel.Dock="Right" Text="0" Width="36" TextAlignment="Right"/><Slider Name="Rate" Minimum="-50" Maximum="100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True"/></DockPanel><TextBlock Text="0 为默认语速" FontSize="12" Foreground="#75867E"/><Separator Margin="0,24,0,18"/><TextBlock Text="整片配音" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="顺序生成尚未完成或已修改的片段，避免重复调用。" FontSize="12" Foreground="#75867E" Margin="0,8,0,14"/><Button Name="GenerateAllButton" Content="生成全部待处理片段" Margin="0,0,0,8"/><Button Name="ManifestButton" Content="生成 Remotion 音频清单" Margin="0,0,0,8"/><Button Name="ClearVoiceButton" Content="清除当前项目配音" Margin="0,0,0,8"/><TextBlock Text="可按画面字幕生成对齐预览；动作与语音仍需复看。" FontSize="12" Foreground="#75867E" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid><DockPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Name="Status" Text="就绪" Foreground="#516C60" FontSize="13"/><TextBlock Name="Progress" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#71867A" FontSize="12"/></DockPanel>
 </Grid>
</Window>
